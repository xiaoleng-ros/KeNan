# 依赖目录
node_modules/

# 环境变量
.env
.env.local

# 日志文件
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# IDE / AI 工具的本地工作数据（都不该进仓库）
.vscode/
.idea/
.trae/
.workbuddy/

# 调试时 Edge 生成的浏览器 profile（可安全删除）
.edgeprofile/
.edgeprofile*/

# 过程产物：截图验证与旧版半成品归档，不进仓库
# （shoot.js 默认已不写截图到项目内，这里是兜底）
shots/
_old/
_old/avatars-png/          # optimize_avatars.js 生成的原图备份

# 部署产物（deploy/ 里手写脚本和配置要提交，打出来的包不进仓库）
keNan-site.zip

# 历史遗留的中间产物（旧管线脚本输出，已由 site/data/*.json 取代）
all_characters_list.json
api_content.json
characters_raw.json
conan-characters-raw.json
conan_characters.json
conan_page.html
missing_avatars_*.json
